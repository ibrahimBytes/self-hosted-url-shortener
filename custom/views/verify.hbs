{{> header}}

<section id="verify" class="section-container verify-page">
  {{#if token_verified}}
    <div class="verification-status success">
      {{> icons/check}}
      <h1>Account Verified</h1>
      <p>Your account has been verified successfully.</p>
      <p class="redirect-message">Redirecting to the homepage...</p>

      <div
        hx-get="/"
        hx-trigger="load delay:2s"
        hx-target="body"
        hx-push-url="/">
      </div>
    </div>
  {{else}}
    <div class="verification-status error">
      {{> icons/x}}
      <h1>Verification Failed</h1>
      <p>The verification link is invalid or has expired. Please try again.</p>

      <a href="/login" class="btn btn-primary" title="Log in or sign up">
        Log in / sign up →
      </a>
    </div>
  {{/if}}
</section>

{{> footer}} 