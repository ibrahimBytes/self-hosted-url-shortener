{{> header}}
<section id="settings" class="section-container">
  <p class="eyebrow">Workspace settings</p>
  <h1 class="settings-welcome">
    Welcome back, <span>{{user.email}}</span>.
  </h1>
  <p class="settings-intro">Configure your Trimly domains, API access, account security, and profile details.</p>
  <hr />
  {{> settings/domain/index}}
  <hr />
  {{> settings/apikey}}
  <hr />
  {{> settings/change_password}}
  <hr />
  {{#if mail_enabled}}
    {{> settings/change_email}}
    <hr />
  {{/if}}
  {{> settings/delete_account}}
</section>
{{> footer}}
